PORT=5000
NODE_ENV=development

# Supabase (Server-only credentials)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=german-auto-media

# Authentication
JWT_SECRET=your-secure-jwt-secret-minimum-32-chars
JWT_EXPIRES_IN=15m

# Client Origin
FRONTEND_URL=http://localhost:5173

# Optional: Email Service Provider (Select Resend or SMTP)
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=