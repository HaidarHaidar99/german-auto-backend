PORT=5000
NODE_ENV=development

# Supabase (Server-only credentials)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=german-auto-media

# Authentication
JWT_SECRET=your-secure-jwt-secret-minimum-32-chars
JWT_EXPIRES_IN=24h
# Cookie name is 'german_auto_jwt'

# Client Origin (Used for email verification and password reset links)
FRONTEND_URL=http://localhost:5173

# Google OAuth (Customer accounts only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production Transactional Email Service (Resend REST API)
# 1. Obtain an API key from https://resend.com/api-keys
# 2. Add your sending domain in Resend Dashboard -> Domains and configure the DKIM & SPF DNS records
# 3. For development/testing without a verified domain, Resend provides: German Auto <onboarding@resend.dev>
#    (Note: onboarding@resend.dev can only deliver to the account owner's email address)
# 4. For production, specify your verified domain sender, e.g.: German Auto <noreply@germanauto.de>
RESEND_API_KEY=
EMAIL_FROM="German Auto <onboarding@resend.dev>"

# Alternative: Direct SMTP / Gmail App Password (can deliver to ANY recipient without domain verification)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-google-app-password